# Configuracoes do Servidor
# Porta onde a API e o WebSocket do servidor escutam (padrao 3001)
PORT=3001

# Banco de dados Postgres
# URL completa de conexao com o PostgreSQL: postgresql://<user>:<password>@<host>:<port>/<database>
# Desenvolvimento local (infra/compose/compose.dev.yaml):
# postgresql://sgm:sgm_secret@localhost:5432/sgm_dev
# Producao ou container (infra/compose/compose.prod.yaml):
# postgresql://sgm:sgm_secret@postgres:5432/sgm_prod
DATABASE_URL=postgresql://sgm:sgm_secret@localhost:5432/sgm_dev

# Cliente Web (Vite)
# URL base do servidor backend acessivel pelo navegador
VITE_SERVER_URL=http://localhost:3001

# Integracao com Spotify (Soundpad)
# Client ID obtido no painel de desenvolvedores do Spotify (opcional em desenvolvimento)
VITE_SPOTIFY_CLIENT_ID=
