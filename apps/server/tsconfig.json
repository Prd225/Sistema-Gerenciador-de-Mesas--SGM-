{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "target": "es2023",
    "module": "esnext",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["node"],
    "ignoreDeprecations": "6.0",
    "baseUrl": ".",
    "paths": {
      "@sgm/shared": ["../../packages/shared/src/index.ts"],
      "@sgm/shared/*": ["../../packages/shared/src/*"]
    }
  },
  "include": ["src"]
}
