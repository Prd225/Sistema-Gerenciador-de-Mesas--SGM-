{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2023"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "verbatimModuleSyntax": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "baseUrl": ".",
    "paths": {
      "@sgm/shared": ["./packages/shared/src/index.ts"],
      "@sgm/shared/*": ["./packages/shared/src/*"],
      "@sgm/engine": ["./packages/engine/src/index.ts"],
      "@sgm/engine/*": ["./packages/engine/src/*"]
    }
  }
}
