{
  "name": "sistema-gerenciador-de-mesas",
  "private": true,
  "version": "7.0.0",
  "license": "UNLICENSED",
  "description": "Sistema Gerenciador de Mesas (SGM v7.0) - Virtual Tabletop (VTT) e Ferramenta do Mestre para RPG",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "start": "npm run dev",
    "dev": "concurrently -n web,server -c cyan,green \"npm run dev --workspace=@sgm/web\" \"npm run dev --workspace=@sgm/server\"",
    "dev:client": "npm run dev --workspace=@sgm/web",
    "dev:server": "npm run dev --workspace=@sgm/server",
    "build": "tsc -b && npm run build --workspace=@sgm/web",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "tsc -b --noEmit",
    "lint": "oxlint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "depcruise": "depcruise --config .dependency-cruiser.cjs apps packages",
    "preview": "npm run preview --workspace=@sgm/web",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run depcruise && npm test && npm run build"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource-variable/geist": "^5.2.9",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cors": "^2.8.5",
    "dexie": "^4.4.4",
    "dexie-react-hooks": "^4.4.0",
    "express": "^4.21.2",
    "konva": "^10.3.0",
    "lucide-react": "^1.23.0",
    "pg": "^8.23.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-error-boundary": "^6.1.6",
    "react-konva": "^19.2.5",
    "react-youtube": "^10.1.0",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "use-image": "^1.1.4",
    "zod": "^4.6.5",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.25",
    "@types/node": "^24.13.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "autoprefixer": "^10.5.2",
    "concurrently": "^10.0.5",
    "dependency-cruiser": "^18.4.0",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^29.1.1",
    "oxlint": "^1.71.0",
    "postcss": "^8.5.16",
    "prettier": "^3.9.6",
    "shadcn": "^4.21.0",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.19.3",
    "typescript": "~6.0.2",
    "vite": "^8.1.1",
    "vitest": "^5.0.1"
  }
}
