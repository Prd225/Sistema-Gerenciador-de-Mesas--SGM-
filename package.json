{
  "name": "sistema-gerenciador-de-mesas",
  "private": true,
  "version": "7.0.0",
  "license": "UNLICENSED",
  "description": "Sistema Gerenciador de Mesas (SGM v7.0) - Virtual Tabletop (VTT) e Ferramenta do Mestre para RPG",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "start": "npm run dev",
    "dev": "concurrently -n web,server -c cyan,green \"npm run dev --workspace=@sgm/web\" \"npm run dev --workspace=@sgm/server\"",
    "dev:client": "npm run dev --workspace=@sgm/web",
    "dev:server": "npm run dev --workspace=@sgm/server",
    "build": "tsc -b && npm run build --workspace=@sgm/web",
    "test": "npm run test --workspaces --if-present",
    "test:e2e": "npm run test:e2e --workspace=@sgm/web",
    "typecheck": "tsc -b --noEmit",
    "lint": "oxlint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "depcruise": "depcruise --config .dependency-cruiser.cjs apps packages",
    "preview": "npm run preview --workspace=@sgm/web",
    "docs:size": "node scripts/check-docs-size.mjs",
    "check": "npm run format:check && npm run docs:size && npm run lint && npm run typecheck && npm run depcruise && npm test && npm run build",
    "prepare": "git config core.hooksPath .githooks || true"
  },
  "devDependencies": {
    "concurrently": "^10.0.5",
    "dependency-cruiser": "^18.4.0",
    "oxlint": "^1.71.0",
    "prettier": "^3.9.6",
    "typescript": "~6.0.2"
  }
}
